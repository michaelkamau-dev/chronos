{
  "name": "chronos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:invariants": "node --test test/invariants.test.js",
    "test:budget": "npm run build && node --test test/budget.test.js",
    "test:wm": "playwright test test/browser/wm.spec.ts",
    "test:perf": "playwright test --grep @perf",
    "test": "npm run typecheck && npm run test:invariants && npm run test:budget && npm run test:browser",
    "test:a11y": "playwright test test/browser/a11y.spec.ts",
    "test:browser": "playwright test",
    "test:fs": "playwright test test/browser/fs.spec.ts",
    "fonts:compare": "node tools/font-compare/build.mjs",
    "fonts:tiger": "node tools/font-compare/tiger-lucida.mjs",
    "test:xp": "playwright test test/browser/xp-fidelity.spec.ts",
    "test:win31": "playwright test test/browser/win31-fidelity.spec.ts",
    "test:tiger": "playwright test test/browser/tiger-fidelity.spec.ts",
    "test:system1": "playwright test test/browser/system1-fidelity.spec.ts",
    "test:ledger": "playwright test test/browser/ledger-fidelity.spec.ts",
    "fonts:ledger": "node tools/font-compare/ledger-publicsans.mjs"
  },
  "dependencies": {
    "idb-keyval": "^6.2.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
